<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutDashboard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <RelativeLayout
        android:id="@+id/layoutHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="120dp"
        android:background="#1E3A5F"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="40dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/layoutHeaderText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtAppName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Présence Manager"
                android:textColor="#FF9800"
                android:textSize="25sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/txtSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tableau de bord"
                android:textColor="#CBD5E1"
                android:textSize="15sp"
                android:layout_marginTop="6dp"/>

        </LinearLayout>

        <ImageView
            android:id="@+id/imgProfil"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@android:drawable/ic_menu_myplaces"/>

    </RelativeLayout>

    <TextView
        android:id="@+id/txtBienvenue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bienvenue, Formateur"
        android:textSize="23sp"
        android:textColor="#1E3A5F"
        android:textStyle="bold"
        android:layout_marginTop="32dp"
        android:layout_marginStart="18dp"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/txtInstruction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Choisissez une fonctionnalité"
        android:textSize="15sp"
        android:textColor="#64748B"
        android:layout_marginTop="8dp"
        android:layout_marginStart="18dp"
        app:layout_constraintTop_toBottomOf="@id/txtBienvenue"
        app:layout_constraintStart_toStartOf="parent"/>

    <GridLayout
        android:id="@+id/gridFonctionnalites"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="2"
        android:layout_marginTop="32dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        app:layout_constraintTop_toBottomOf="@id/txtInstruction"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/cardGroupes"
            android:layout_width="0dp"
            android:layout_height="145dp"
            android:layout_row="0"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:layout_gravity="fill"
            android:background="#E0E7FF"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_margin="6dp"
            android:padding="12dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_menu_agenda"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Groupes"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#1E3A5F"
                android:layout_marginTop="12dp"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardAppel"
            android:layout_width="0dp"
            android:layout_height="145dp"
            android:layout_row="0"
            android:layout_column="1"
            android:layout_columnWeight="1"
            android:layout_gravity="fill"
            android:background="#DBEAFE"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_margin="6dp"
            android:padding="12dp">

            <FrameLayout
                android:id="@+id/frameAppel"
                android:layout_width="48dp"
                android:layout_height="48dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@android:drawable/ic_menu_edit"/>

                <androidx.cardview.widget.CardView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="top|end"
                    app:cardBackgroundColor="#DC2626"
                    app:cardCornerRadius="11dp"
                    app:cardElevation="0dp">

                    <TextView
                        android:id="@+id/txtBadge"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="1"
                        android:textSize="12sp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:gravity="center"/>

                </androidx.cardview.widget.CardView>

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Faire l'appel"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#1E3A5F"
                android:layout_marginTop="12dp"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardHistorique"
            android:layout_width="0dp"
            android:layout_height="145dp"
            android:layout_row="1"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:layout_gravity="fill"
            android:background="#D1FAE5"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_margin="6dp"
            android:padding="12dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_menu_recent_history"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Historique"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#1E3A5F"
                android:layout_marginTop="12dp"/>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardStatistiques"
            android:layout_width="0dp"
            android:layout_height="145dp"
            android:layout_row="1"
            android:layout_column="1"
            android:layout_columnWeight="1"
            android:layout_gravity="fill"
            android:background="#FEF3C7"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_margin="6dp"
            android:padding="12dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_menu_sort_by_size"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Statistiques"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#1E3A5F"
                android:layout_marginTop="12dp"/>

        </LinearLayout>

    </GridLayout>

    <TextView
        android:id="@+id/txtFooterDashboard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PrésenceManager - Version 1.0"
        android:textSize="12sp"
        android:textColor="#94A3B8"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
